# Подключение к PostgreSQL внутри docker-compose сети
DB_HOST=postgres
DB_PORT=5432
DB_NAME=habittracker
DB_USER=postgres
DB_PASSWORD=root

# Spring Boot переопределит свойства из application.properties
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}